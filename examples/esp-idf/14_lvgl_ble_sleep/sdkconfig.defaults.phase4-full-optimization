# ============================================================
# FASE 4 — Full Optimization (XTAL_PU + PHY PD + otimizações)
# ============================================================
# Objetivo: com auto light sleep já confirmado, adicionar
# otimizações reais de consumo com base na doc oficial IDF 6.0.
#
# Flags testadas individualmente:
#   - XTAL_PU: hardware mantém xtal no light sleep (REQUISITO)
#   - PHY PD: economia extra desligando MAC/BB
#   - PSRAM leakage workaround: necessário para PSRAM no sleep
#
# Uso: cp sdkconfig.defaults.phase4-full-optimization sdkconfig.defaults
#      idf.py set-target esp32s3 && idf.py build && idf.py flash
#
# IMPORTANTE:
#   - POWER_DOWN_FLASH REMOVIDO (obsoleto no IDF 5.5.4, docs oficiais
#     confirmam que é ignorado; incompatível com PSRAM)
#   - XTAL_PU é a flag crítica: sem ela, bt.c seta no_light_sleep=1
#     e o sistema nunca entra em light sleep
# ============================================================

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# LVGL
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"

# BLE NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# ============================================================
# BLE Modem Sleep + XTAL_PU
# ============================================================
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y

# XTAL_PU: MANDATÓRIO para light sleep com BLE
# Sem esta flag, bt.c:1733-1737 seta no_light_sleep=1
# e o sistema nunca dorme (confirmado via doc IDF 6.0)
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# ============================================================
# Auto Light Sleep (herdado da Fase 3)
# ============================================================
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# ============================================================
# Otimizações de consumo (NOVO nesta fase)
# ============================================================

# PHY MAC/BB power-down durante sleep (economia adicional)
CONFIG_ESP_PHY_MAC_BB_PD=y

# PSRAM leakage workaround — necessário para evitar corrupção
# de PSRAM durante light sleep
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y

# Otimizações PM (já testadas na Fase 3)
CONFIG_PM_SLP_IRAM_OPT=y

# ============================================================
# Log level INFO final (sem debug verbose)
# ============================================================
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y

# ============================================================
# Flags REMOVIDAS vs configuração atual:
# ============================================================
# [REMOVED] CONFIG_ESP_SLEEP_POWER_DOWN_FLASH  (obsoleto, ignorado IDF 5.5.4)
# [REMOVED] CONFIG_PM_PROFILING                 (desabilitado para economia)
# [REMOVED] CONFIG_PM_TRACE                     (desabilitado para economia)
# [ADDED]   CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP  (MANDATÓRIO)
